# Copy this file to .env (cp .env.example .env) and fill in the blanks.
# .env is git-ignored. NEVER put real values in this example file.
#
# Format rules (the project's tiny .env reader is simple):
#   * one KEY=value per line, no spaces around "="
#   * comments only on their own line (no "KEY=value  # comment")
#   * a variable already exported in your shell wins over this file

# ---- Secrets (generate each one yourself; see docs/ENVIRONMENT.md) ----
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
N8N_ENCRYPTION_KEY=

# ---- Gmail ----
# Address that receives admin alerts (delivery failures, stuck students, n8n errors). Leave empty = no alert emails.
# Gmail itself is connected with OAuth inside n8n (credential "Gmail OAuth2 API"): no password or token goes in this file.
ADMIN_EMAIL=

# ---- FastAPI <-> n8n (local only) ----
FASTAPI_BASE_URL=http://127.0.0.1:8000
# n8n must listen on this machine only. scripts/start_n8n.sh refuses anything else.
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_PORT=5678
# n8n data folder (default used by scripts/start_n8n.sh: $HOME/.n8n-learning-system).
# Keep it OUTSIDE this project folder. Uncomment only to change it; use an absolute path.
# N8N_USER_FOLDER=/Users/yourname/.n8n-learning-system

# ---- Learning engine (all optional) ----
LEARNING_DB_PATH=data/learning.db
CURRICULUM_DIR=app/curriculum/content
MASTERY_RULES_PATH=app/curriculum/mastery_rules.yaml
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MAX_OUTPUT_BYTES=20000
# Comma-separated modules students may import in submitted code:
SANDBOX_ALLOWED_MODULES=math,random,datetime,time,string,statistics,collections,itertools,functools,json,re,decimal,fractions,typing,operator,textwrap,calendar

# ---- API server ----
# Keep API_HOST=127.0.0.1. Never set 0.0.0.0 (that would expose the API to your network).
API_HOST=127.0.0.1
API_PORT=8000
APP_TIMEZONE=Asia/Kolkata
DEFAULT_SEND_TIME=08:00
MAX_LESSONS_PER_DAY=2
INACTIVE_ALERT_DAYS=3
RATE_LIMIT_PER_MINUTE=10
JOIN_CODE_TTL_HOURS=72
DAILY_MAX_FAILURES=3
AUTO_HINT_AFTER_ATTEMPTS=2
BACKUP_DIR=data/backups
BACKUP_KEEP=7
